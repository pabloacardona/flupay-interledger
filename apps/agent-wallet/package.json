{
  "name": "@flupay/agent-wallet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env src/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "vercel-build": "prisma generate && prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@flupay/shared": "workspace:*",
    "@interledger/open-payments": "^7.4.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "dotenv": "^18.0.8",
    "prisma": "^7"
  }
}
