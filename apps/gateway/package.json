{
  "name": "@flupay/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "test": "tsx --test src/*.test.ts",
    "tunnel": "npx --yes cloudflared tunnel --url http://localhost:8080",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flupay/shared": "workspace:*",
    "@fastify/http-proxy": "^11.6.0",
    "@prisma/client": "^7.0.0",
    "fastify": "^5.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "prisma": "^7.0.0"
  }
}
