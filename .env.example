# Copy to .env and fill in. Never commit .env or .key files.
# Test wallets and developer keys: https://wallet.interledger-test.dev

# --- Shared ---
# 32 bytes hex for AES-256-GCM: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Gateway (apps/gateway, port 8080) ---
GATEWAY_PORT=8080
# Upstream and per-route prices (relative to apps/gateway)
GATEWAY_CONFIG_PATH=./gateway.yaml
# The gateway charges through the FluPay charges API; it holds no Open Payments keys.
GATEWAY_FLUPAY_URL=https://useflupay.space
# Merchant secret key (sk_...) from the dashboard, API keys section
GATEWAY_FLUPAY_API_KEY=
# Optional: enables GET /_gateway/stats with "Authorization: Bearer <key>" (16+ chars)
GATEWAY_ADMIN_KEY=

# --- Agent wallet (apps/agent-wallet, port 4000) ---
AGENT_WALLET_PORT=4000
# Neon Postgres, provisioned via Vercel Marketplace. Get them with: vercel env pull .env.local
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AGENT_WALLET_PUBLIC_URL=http://localhost:4000
# Wallet address that identifies the agent-wallet service as a GNAP client
AGENT_WALLET_CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/<agent-wallet-client>
AGENT_WALLET_CLIENT_KEY_ID=
# Use ONE of these: the PEM contents (or base64 of it; preferred on Vercel) or a file path (local)
AGENT_WALLET_CLIENT_PRIVATE_KEY=
AGENT_WALLET_CLIENT_PRIVATE_KEY_PATH=../../keys/agent-wallet.key
# Where /grants/callback redirects when done
DASHBOARD_URL=http://localhost:3001
# Max time to wait for an outgoing payment to settle (ms)
PAYMENT_TIMEOUT_MS=15000

# --- Demo API (apps/demo-api, port 3000) ---
DEMO_API_PORT=3000

# --- Web: merchant platform (apps/web, port 3001). Local values live in apps/web/.env.local (vercel env pull) ---
# DATABASE_URL=, DATABASE_URL_UNPOOLED=   (its own Neon database)
# ENCRYPTION_KEY=
# PUBLIC_URL=http://localhost:3001
# FLUPAY_CLIENT_WALLET_ADDRESS=, FLUPAY_CLIENT_KEY_ID=, FLUPAY_CLIENT_PRIVATE_KEY=   (platform's Open Payments identity)

# --- Demo wallets ---
SITE_WALLET_ADDRESS=https://ilp.interledger-test.dev/<site>
AGENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/<agent>
